# Copy to .env (never commit). Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTHGUARD_ENV=production
AUTHGUARD_SECRET_KEY=
AUTHGUARD_API_KEY=
AUTHGUARD_CORS_ORIGINS=https://app.example.com
# Set to true ONLY behind a reverse proxy/CDN you control (Cloudflare, ALB, nginx) that overwrites these headers
AUTHGUARD_TRUST_PROXY_HEADERS=false
# Browser-reported asn/country/city/rtt are spoofable. Leave false in production and inject geo via your gateway.
AUTHGUARD_TRUST_CLIENT_TELEMETRY=false
AUTHGUARD_DB_PATH=/app/var/authguard.db
RATE_LIMIT_LOGIN=25
RATE_LIMIT_GLOBAL=150
